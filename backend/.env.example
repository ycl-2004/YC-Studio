# App
APP_NAME=YC Studio
ENVIRONMENT=development
DEBUG=false
API_PREFIX=/api
READINESS_TIMEOUT_SECONDS=1.0
UPLOAD_MAX_BYTES=10485760
UPLOAD_STORAGE_DIR=./data/uploads
SEED_PUBLIC_LIBRARIES=0
BACKEND_PORT=8000
FRONTEND_PORT=5173
# JSON array; pydantic-settings parses list values as JSON.
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Database (PostgreSQL + pgvector)
POSTGRES_DB=ycstudio
POSTGRES_USER=ycstudio
POSTGRES_PASSWORD=replace-with-a-local-dev-password
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://ycstudio:replace-with-a-local-dev-password@localhost:5433/ycstudio
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30

# Redis
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

# LLM (provider/model are intentionally left for implementation-time selection)
LLM_PROVIDER=<provider>
LLM_API_KEY=<api-key>
LLM_MODEL=<model-name>
LLM_BASE_URL=https://<provider-host>/v1
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# Embedding
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
EMBEDDING_DIMENSION=768
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_LOCAL_FILES_ONLY=true

# RAG
CHUNK_SIZE=512
CHUNK_OVERLAP=51
CHUNK_METHOD=recursive
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.65

# Ingestion
INGEST_BATCH_SIZE=200
